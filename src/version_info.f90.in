! Generated by CMake (configure_file) into the build folder: version, compiler and
! build date of this executable.
!   amrs_version: the information only (used by the --version option)
!   amrs_banner:  the same, plus the "reading APEXRUN.DAT" line, at the start of each run
subroutine amrs_version
  implicit none
  write (*,'(a)') ''
  write (*,'(a)') '   APEX-MODFLOW-RT3D-Salt (AMRS) rev.24-003'
  write (*,'(a)') '   APEX1501 + MODFLOW-NWT + RT3D + Salinity'
  write (*,'(a)') ''
  write (*,'(a)') '   AMRS @AMRS_VERSION@'
  write (*,'(a)') '   @CMAKE_Fortran_COMPILER_ID@ @CMAKE_Fortran_COMPILER_VERSION@, @CMAKE_BUILD_TYPE@, @CMAKE_HOST_SYSTEM_NAME@'
  write (*,'(a)') '   built @ISO@'
  write (*,'(a)') ''
end subroutine amrs_version

subroutine amrs_banner
  implicit none
  call amrs_version
  write (*,'(a)') ' Program reading from file APEXRUN.DAT . . . executing'
  write (*,'(a)') ''
end subroutine amrs_banner
